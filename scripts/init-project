#!/usr/bin/env bash
# Instancia un repositorio de proyecto InfoSails.
# La memoria (historias/blueprints) vive en el proyecto; el kit queda en HARNESS_HOME.
set -euo pipefail

usage() {
  cat <<'EOF'
Uso:
  init-project <nombre> [--path <dir>] [--into <dir-existente>] [--no-git]

Ejemplos:
  init-project mi-app
  init-project mi-app --path ~/Projects/mi-app
  init-project . --into ~/Projects/app-existente   # adopta un repo ya creado

Variables:
  INFOSAILS_HARNESS_HOME  Fallback si el comando no vive dentro de un kit
EOF
}

# Preferir el kit del propio comando (siguiendo el symlink). Evita shells con
# INFOSAILS_HARNESS_HOME viejo tras reinstalar otra versión.
resolve_script() {
  local src="$1"
  if [[ "$src" != /* ]]; then
    src="$(pwd)/$src"
  fi
  while [[ -L "$src" ]]; do
    local link
    link="$(readlink "$src")"
    if [[ "$link" == /* ]]; then
      src="$link"
    else
      src="$(cd "$(dirname "$src")" && pwd)/$link"
    fi
  done
  printf '%s\n' "$src"
}

SCRIPT_PATH="$(resolve_script "${BASH_SOURCE[0]:-$0}")"
SCRIPT_KIT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
ENV_KIT="${INFOSAILS_HARNESS_HOME:-}"

if [[ -f "$SCRIPT_KIT/config/harness.yaml" ]]; then
  HARNESS_HOME="$SCRIPT_KIT"
  if [[ -n "$ENV_KIT" && "$ENV_KIT" != "$HARNESS_HOME" ]]; then
    echo "Aviso: INFOSAILS_HARNESS_HOME apunta a:" >&2
    echo "         $ENV_KIT" >&2
    echo "       pero infosails-init está en:" >&2
    echo "         $HARNESS_HOME" >&2
    echo "       Usando el del comando. Para alinear: source ~/.zshrc (o nueva terminal)." >&2
  fi
elif [[ -n "$ENV_KIT" && -f "$ENV_KIT/config/harness.yaml" ]]; then
  HARNESS_HOME="$ENV_KIT"
else
  echo "No encuentro kit InfoSails (config/harness.yaml)." >&2
  echo "Instalá con ./scripts/install desde un pack/runtime." >&2
  exit 1
fi

KIT_VERSION="$(awk '/^version:/{ print $2; exit }' "$HARNESS_HOME/config/harness.yaml" 2>/dev/null || echo "?")"
KIT_VERSION="${KIT_VERSION%\"}"
KIT_VERSION="${KIT_VERSION#\"}"

TEMPLATE="$HARNESS_HOME/templates/project"
NAME=""
TARGET=""
INTO=""
NO_GIT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --path) TARGET="${2:-}"; shift 2 ;;
    --into) INTO="${2:-}"; shift 2 ;;
    --no-git) NO_GIT=1; shift ;;
    -*)
      echo "Opción desconocida: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -z "$NAME" ]]; then NAME="$1"; shift
      else echo "Argumento extra: $1" >&2; exit 1
      fi
      ;;
  esac
done

if [[ -z "$NAME" ]]; then
  usage
  exit 1
fi

if [[ ! -d "$TEMPLATE" ]]; then
  echo "No encuentro template de proyecto en: $TEMPLATE" >&2
  exit 1
fi

CREATED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

if [[ -n "$INTO" ]]; then
  TARGET="$(cd "$INTO" && pwd)"
  if [[ "$NAME" == "." ]]; then
    NAME="$(basename "$TARGET")"
  fi
else
  if [[ -z "$TARGET" ]]; then
    TARGET="$(pwd)/$NAME"
  fi
  if [[ -e "$TARGET" ]]; then
    echo "Ya existe: $TARGET" >&2
    echo "Usa --into para adoptar un directorio existente." >&2
    exit 1
  fi
  mkdir -p "$TARGET"
fi

echo "Kit:      $HARNESS_HOME (v$KIT_VERSION)"
echo "Proyecto: $TARGET"
echo "Nombre:   $NAME"

# Memoria + metadatos del proyecto
cp -R "$TEMPLATE/memory" "$TARGET/memory"
cp "$TEMPLATE/AGENTS.md" "$TARGET/AGENTS.md"
cp "$TEMPLATE/harness.project.yaml" "$TARGET/harness.project.yaml"

# README: no pisar uno existente al adoptar
if [[ ! -f "$TARGET/README.md" ]]; then
  cp "$TEMPLATE/README.md" "$TARGET/README.md"
fi

# Templates y schemas
mkdir -p "$TARGET/templates" "$TARGET/schemas"
cp "$HARNESS_HOME/templates/feature-blueprint.md" "$TARGET/templates/feature-blueprint.md"
cp "$HARNESS_HOME/templates/design-package.md" "$TARGET/templates/design-package.md"
cp "$HARNESS_HOME/templates/adr.md" "$TARGET/templates/adr.md"
cp "$HARNESS_HOME/templates/build-report.md" "$TARGET/templates/build-report.md"
cp "$HARNESS_HOME/templates/onboard-report.md" "$TARGET/templates/onboard-report.md"
cp "$HARNESS_HOME/templates/deploy-report.md" "$TARGET/templates/deploy-report.md"
cp "$HARNESS_HOME/schemas/feature-blueprint.schema.json" "$TARGET/schemas/feature-blueprint.schema.json"
cp "$HARNESS_HOME/schemas/design-package.schema.json" "$TARGET/schemas/design-package.schema.json"
cp "$HARNESS_HOME/schemas/build-report.schema.json" "$TARGET/schemas/build-report.schema.json"
cp "$HARNESS_HOME/schemas/deploy-report.schema.json" "$TARGET/schemas/deploy-report.schema.json"
cp "$HARNESS_HOME/schemas/director-state.schema.json" "$TARGET/schemas/director-state.schema.json"
cp "$HARNESS_HOME/schemas/process-lead-state.schema.json" "$TARGET/schemas/process-lead-state.schema.json"
cp "$HARNESS_HOME/schemas/backlog.schema.json" "$TARGET/schemas/backlog.schema.json"
cp "$HARNESS_HOME/schemas/costs-ledger.schema.json" "$TARGET/schemas/costs-ledger.schema.json"

if [[ -f "$TEMPLATE/.env.example" ]]; then
  cp "$TEMPLATE/.env.example" "$TARGET/.env.example"
fi

# Agentes y rules del kit → el proyecto puede operar solo en Cursor
SKILLS_SRC="$HARNESS_HOME/.cursor/skills"
if [[ ! -d "$SKILLS_SRC" ]]; then
  SKILLS_SRC="$HARNESS_HOME/skills"  # layout del pack runtime
fi
if [[ ! -d "$SKILLS_SRC" ]]; then
  echo "No encuentro skills en $HARNESS_HOME/.cursor/skills ni $HARNESS_HOME/skills" >&2
  exit 1
fi

mkdir -p "$TARGET/.cursor/skills" "$TARGET/.cursor/rules"
cp -R "$SKILLS_SRC/director" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/discovery" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/bug" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/design" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/build" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/onboard" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/deploy" "$TARGET/.cursor/skills/"
cp -R "$SKILLS_SRC/_shared" "$TARGET/.cursor/skills/"
RULES_SRC="$TEMPLATE/.cursor/rules"
if [[ ! -d "$RULES_SRC" ]]; then
  RULES_SRC="$TEMPLATE/cursor-rules"
fi
if [[ ! -d "$RULES_SRC" ]]; then
  echo "No encuentro rules del template (.cursor/rules ni cursor-rules)" >&2
  exit 1
fi
cp "$RULES_SRC/"*.mdc "$TARGET/.cursor/rules/"

# Hooks de uso de tokens (stop → memory/costs/)
HOOKS_JSON="$TEMPLATE/.cursor/hooks.json"
if [[ ! -f "$HOOKS_JSON" ]]; then
  HOOKS_JSON="$TEMPLATE/cursor-hooks/hooks.json"
fi
HOOK_SCRIPT="$HARNESS_HOME/scripts/record-usage"
mkdir -p "$TARGET/.cursor/hooks"
if [[ -f "$HOOK_SCRIPT" ]]; then
  cp "$HOOK_SCRIPT" "$TARGET/.cursor/hooks/record-usage.py"
  chmod +x "$TARGET/.cursor/hooks/record-usage.py"
fi
if [[ -f "$HOOKS_JSON" ]]; then
  if [[ -f "$TARGET/.cursor/hooks.json" ]]; then
    python3 - "$HOOKS_JSON" "$TARGET/.cursor/hooks.json" <<'PY'
import json, sys
from pathlib import Path
src = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
dest_path = Path(sys.argv[2])
try:
    dest = json.loads(dest_path.read_text(encoding="utf-8"))
except Exception:
    dest = {"version": 1, "hooks": {}}
hooks = dest.setdefault("hooks", {})
for event, entries in (src.get("hooks") or {}).items():
    existing = hooks.get(event) or []
    cmds = { (e.get("command") if isinstance(e, dict) else None) for e in existing }
    for e in entries:
        if isinstance(e, dict) and e.get("command") not in cmds:
            existing.append(e)
    hooks[event] = existing
dest_path.write_text(json.dumps(dest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
  else
    cp "$HOOKS_JSON" "$TARGET/.cursor/hooks.json"
  fi
fi

# Sustituir placeholders
replace_in() {
  local file="$1"
  if [[ "$(uname)" == "Darwin" ]]; then
    sed -i '' \
      -e "s|{{PROJECT_NAME}}|$NAME|g" \
      -e "s|{{CREATED_AT}}|$CREATED_AT|g" \
      -e "s|{{HARNESS_HOME}}|$HARNESS_HOME|g" \
      "$file"
  else
    sed -i \
      -e "s|{{PROJECT_NAME}}|$NAME|g" \
      -e "s|{{CREATED_AT}}|$CREATED_AT|g" \
      -e "s|{{HARNESS_HOME}}|$HARNESS_HOME|g" \
      "$file"
  fi
}

replace_in "$TARGET/harness.project.yaml"
replace_in "$TARGET/README.md"
replace_in "$TARGET/AGENTS.md"
replace_in "$TARGET/memory/director-state.json"
replace_in "$TARGET/memory/processes/discovery/state.json"
replace_in "$TARGET/memory/processes/bug/state.json"
replace_in "$TARGET/memory/processes/design/state.json"
replace_in "$TARGET/memory/processes/build/state.json"
replace_in "$TARGET/memory/processes/onboard/state.json"
replace_in "$TARGET/memory/processes/deploy/state.json"
replace_in "$TARGET/memory/architecture/landscape.md"
replace_in "$TARGET/memory/architecture/landscape.json"

# .gitignore mínimo si no hay
if [[ ! -f "$TARGET/.gitignore" ]]; then
  cat > "$TARGET/.gitignore" <<'EOF'
.DS_Store
.env
.env.*
!.env.example
node_modules/
dist/
build/
.venv/
__pycache__/
*.log
memory/costs/.lock
memory/costs/seen.json
EOF
fi

if [[ "$NO_GIT" -eq 0 ]]; then
  if [[ ! -d "$TARGET/.git" ]]; then
    git -C "$TARGET" init -q
    echo "Git: inicializado en $TARGET"
  fi
fi

cat <<EOF

Listo. Proyecto instanciado.

  cd "$TARGET"
  # Abre esta carpeta en Cursor y escribe: hola
  # Si el repo ya tenía código: elige Onboard para hidratar memory/

Memoria (historias) → $TARGET/memory/blueprints/
Kit de origen       → $HARNESS_HOME

EOF
