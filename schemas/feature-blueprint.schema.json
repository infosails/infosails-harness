{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infosails.dev/schemas/feature-blueprint.schema.json",
  "title": "Feature Blueprint",
  "description": "Representación máquina-legible del Feature Blueprint producido por Discovery. El artefacto canónico para humanos/agentes de build es el .md; este JSON es el índice estructurado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "epic",
    "status",
    "created_by",
    "problem",
    "users",
    "application_type",
    "existence_inventory",
    "external_integrations",
    "core",
    "out_of_scope",
    "acceptance_criteria",
    "markdown_path",
    "created_at",
    "phase"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BP-[0-9]{8}-[0-9]{3}$",
      "description": "Identificador único del blueprint (ej. BP-20260717-001)"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "epic": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Ready for Design",
        "Ready for Build",
        "In Build",
        "Done",
        "Blocked"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "problem": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "goals"],
          "properties": {
            "role": { "type": "string" },
            "goals": { "type": "string" },
            "context": { "type": ["string", "null"] },
            "frequency": { "type": ["string", "null"] },
            "digital_skill": {
              "type": ["string", "null"],
              "enum": ["novice", "intermediate", "expert", null]
            },
            "device_channel": { "type": ["string", "null"] },
            "permissions": { "type": ["string", "null"] },
            "ux_pains": { "type": ["string", "null"] }
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "goals": { "type": "string" },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "non_users": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "application_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "justification"],
      "properties": {
        "type": {
          "type": "string",
          "description": "backoffice | product_web | customer_portal | marketing | mobile_pwa | api_headless | embedded | job_cli | hybrid:…"
        },
        "primary_channel": { "type": ["string", "null"] },
        "surface": {
          "type": ["string", "null"],
          "enum": ["new", "extension", null]
        },
        "justification": { "type": "string" },
        "alternatives_considered": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implications": { "type": ["string", "null"] }
      }
    },
    "existence_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["already_exists", "partial", "new"],
      "properties": {
        "already_exists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "where": { "type": ["string", "null"] }
            }
          }
        },
        "partial": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "missing"],
            "properties": {
              "text": { "type": "string" },
              "already_there": { "type": ["string", "null"] },
              "missing": { "type": "string" }
            }
          }
        },
        "new": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "external_integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_external"],
      "properties": {
        "has_external": { "type": "boolean" },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "integration_types"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": {
                "type": ["string", "null"],
                "description": "Para qué se usa el proveedor en esta historia"
              },
              "integration_types": {
                "type": "object",
                "additionalProperties": false,
                "description": "Matriz completa: cada clave del catálogo debe aparecer",
                "required": [
                  "sync_api",
                  "webhooks",
                  "redirect_callback",
                  "sdk",
                  "hosted_ui_embed",
                  "batch_files",
                  "events_queue",
                  "email_sms_push",
                  "shared_data_sync",
                  "system_auth",
                  "admin_console_vs_in_app",
                  "environments",
                  "data_privacy",
                  "failure_degradation",
                  "limits_quotas",
                  "operations"
                ],
                "properties": {
                  "sync_api": { "$ref": "#/$defs/integration_type_entry" },
                  "webhooks": { "$ref": "#/$defs/integration_type_entry" },
                  "redirect_callback": { "$ref": "#/$defs/integration_type_entry" },
                  "sdk": { "$ref": "#/$defs/integration_type_entry" },
                  "hosted_ui_embed": { "$ref": "#/$defs/integration_type_entry" },
                  "batch_files": { "$ref": "#/$defs/integration_type_entry" },
                  "events_queue": { "$ref": "#/$defs/integration_type_entry" },
                  "email_sms_push": { "$ref": "#/$defs/integration_type_entry" },
                  "shared_data_sync": { "$ref": "#/$defs/integration_type_entry" },
                  "system_auth": { "$ref": "#/$defs/integration_type_entry" },
                  "admin_console_vs_in_app": { "$ref": "#/$defs/integration_type_entry" },
                  "environments": { "$ref": "#/$defs/integration_type_entry" },
                  "data_privacy": { "$ref": "#/$defs/integration_type_entry" },
                  "failure_degradation": { "$ref": "#/$defs/integration_type_entry" },
                  "limits_quotas": { "$ref": "#/$defs/integration_type_entry" },
                  "operations": { "$ref": "#/$defs/integration_type_entry" }
                }
              }
            }
          }
        },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "has_external": { "const": true } } },
          "then": {
            "required": ["providers"],
            "properties": {
              "providers": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "core": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "done", "existence"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "done": { "type": "boolean", "default": false },
          "existence": {
            "type": "string",
            "enum": ["new", "partial"],
            "description": "Solo new/partial entran al Core; already_exists va al inventario"
          },
          "already_there": { "type": ["string", "null"] },
          "missing": { "type": ["string", "null"] }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "given", "when", "then"],
        "properties": {
          "name": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "markdown_path": {
      "type": "string",
      "description": "Ruta relativa al .md canónico"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "const": "discovery"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "integration_type_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope"],
      "properties": {
        "in_scope": {
          "type": "string",
          "enum": ["yes", "no", "n/a", "unknown"]
        },
        "detail": {
          "type": ["string", "null"],
          "description": "Obligatorio en la práctica cuando in_scope=yes"
        }
      }
    }
  }
}
